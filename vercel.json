{
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "spinwheelhub.vercel.app"
                }
            ],
            "destination": "https://spinwheelhub.org/:path*",
            "permanent": true
        },
        {
            "source": "/wheel/travel",
            "destination": "/wheel/random-country",
            "permanent": true
        },
        {
            "source": "/wheel/life-decisions",
            "destination": "/wheel/yes-no",
            "permanent": true
        },
        {
            "source": "/wheel/food-recipes",
            "destination": "/wheel/what-for-dinner",
            "permanent": true
        },
        {
            "source": "/wheel/entertainment",
            "destination": "/wheel/random-movie",
            "permanent": true
        },
        {
            "source": "/wheel/challenges",
            "destination": "/wheel/truth-or-dare",
            "permanent": true
        },
        {
            "source": "/wheel/company-names",
            "destination": "/custom-wheel-of-names",
            "permanent": true
        },
        {
            "source": "/wheel/astrology",
            "destination": "/hub",
            "permanent": true
        },
        {
            "source": "/wheels",
            "destination": "/hub",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/embed/:path*",
            "destination": "/embed.html"
        },
        {
            "source": "/w/:id",
            "destination": "/shell.html"
        },
        {
            "source": "/giveaway/:id",
            "destination": "/shell.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "all"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        }
    ]
}
